// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}



datasource db {
  provider = "postgresql"
}

// ============ AUTH & USERS ============

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   Membership[]
  documents     Document[]   @relation("DocumentAuthor")
  activityLogs  ActivityLog[]
  invitationsSent     Invitation[] @relation("InvitationCreator")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")
}

// ============ MULTI-TENANCY CORE ============

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  documents    Document[]
  activityLogs ActivityLog[]
  invitations  Invitation[]
}

// Shareable invite links: the token is the capability. No email service
// needed (free-tier constraint) — admins copy the link and send it anywhere.
model Invitation {
  id             String       @id @default(cuid())
  token          String       @unique @default(cuid())
  role           Role         @default(MEMBER)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  invitedBy      User         @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById    String
  acceptedBy     User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id])
  acceptedById   String?

  @@index([organizationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ============ DOCUMENTS ============

model Document {
  id             String       @id @default(cuid())
  title          String       @default("Untitled")
  content        Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  author         User         @relation("DocumentAuthor", fields: [authorId], references: [id])
  authorId       String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  versions       DocumentVersion[]
  chunks         DocumentChunk[]

  @@index([organizationId, updatedAt])
}

// RAG search index: documents split into chunks, each with a 768-dim Gemini
// embedding. organizationId is denormalized onto every chunk so similarity
// search is tenant-filtered in the same SQL query that scans vectors.
model DocumentChunk {
  id             String                 @id @default(cuid())
  chunkIndex     Int
  content        String
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime               @default(now())

  document       Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId     String
  organizationId String

  @@index([documentId])
  @@index([organizationId])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  content    Json?
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  @@index([documentId])
}

// ============ ACTIVITY LOGS ============

model ActivityLog {
  id             String       @id @default(cuid())
  action         String
  metadata       Json?
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id])
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([organizationId, createdAt])
}